        }
      }
    },
    "VIce Bartender needs this to:" : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VIce Bartender cần quyền này để:"
          }
        }
      }
    },
    "VIce Bartender needs your permission to manage the menu bar." : {
      "extractionState" : "manual",
      "localizations" : {
