{
  "sourceLanguage" : "en",
  "version" : "1.0",
  "strings" : {
    "\"%@\" is not movable" : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” không thể di chuyển"
          }
        }
      }
    },
    "\"%@\" took too long to respond" : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” phản hồi quá lâu"
          }
        }
      }
    },
    "%@ does not publish its status to macOS, so VIce Bartender cannot see when it changes." : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ không gửi trạng thái của nó cho macOS nên VIce Bartender không thể biết khi nào trạng thái thay đổi."
          }
        }
      }
    },
    "%@ is unresponsive. Until it is restarted, it cannot be moved. Movement of other menu bar items may also be affected until this is resolved." : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ không phản hồi. Cho đến khi được khởi động lại, mục này không thể di chuyển. Việc di chuyển các mục thanh menu khác cũng có thể bị ảnh hưởng cho đến khi khắc phục."
          }
        }
      }
    },
    "%@ second" : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ giây"
          }
        }
      }
    },
    "%@ seconds" : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ giây"
          }
        }
      }
    },
