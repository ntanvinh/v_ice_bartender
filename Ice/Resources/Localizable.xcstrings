          }
        }
      }
    },
    "VIce Bartender cannot hide %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VIce Bartender không thể ẩn %@."
