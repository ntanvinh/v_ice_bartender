        }
      }
    },
    "Use inset shape on screens with notch" : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng hình thụt vào trên màn hình có tai thỏ"
          }
        }
      }
    },
    "Uses assessment mode, which also removes Control Centre's modules and needs a brief reveal to pass clicks to system items. Only for systems where the native switch does not work." : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng chế độ đánh giá, chế độ này cũng gỡ các mô-đun của Trung tâm điều khiển và cần hiện ra chốc lát để chuyển cú bấm tới các mục hệ thống. Chỉ dành cho máy mà công tắc gốc không hoạt động."
          }
        }
      }
    },
    "Uses macOS's own Allow in the Menu Bar switch for each hidden app. System items stay native, including Focus and the camera indicator, and clicks on them need no reveal. While hidden, those apps show as not allowed in System Settings > Control Center." : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng công tắc “Cho phép trong thanh menu” của chính macOS cho từng ứng dụng bị ẩn. Các mục hệ thống vẫn giữ nguyên, gồm Tập trung và chỉ báo camera, và bấm vào chúng không cần hiện ra trước. Khi bị ẩn, các ứng dụng đó hiện là không được cho phép trong Cài đặt hệ thống > Trung tâm điều khiển."
          }
        }
      }
    },
    "VIce Bartender" : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VIce Bartender"
          }
        }
      }
    },
    "VIce Bartender Settings…" : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cài đặt VIce Bartender…"
          }
        }
      }
    },
    "VIce Bartender can work in a limited mode without this permission." : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VIce Bartender vẫn chạy được ở chế độ hạn chế khi không có quyền này."
          }
        }
      }
    },
    "VIce Bartender cannot arrange menu bar items in automatically hidden menu bars." : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
