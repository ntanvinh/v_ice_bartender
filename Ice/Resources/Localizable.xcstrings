            "value" : "VIce Bartender là bản fork của Ice. © 2025 Jordan Baird, giấy phép GPL-3.0."
          }
        }
      }
    },
    "VIce Bartender is built on the work of the people below." : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VIce Bartender được xây dựng trên công sức của những người dưới đây."
          }
        }
      }
    },
    "VIce Bartender needs the Accessibility permission to press the switch for you." : {
      "extractionState" : "manual",
      "localizations" : {
