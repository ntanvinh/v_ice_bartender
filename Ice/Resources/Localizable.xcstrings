      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bấm chuột phải"
          }
        }
      }
    },
    "© 2025 Jordan Baird · © 2026 %@ · GPL-3.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
