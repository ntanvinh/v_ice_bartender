et/Contents.json","Ice/Resources/Assets.xcassets/Warning.imageset/Warning.png","Ice/Resources/Info.plist","Ice/Settings/Models/AdvancedSettings.swift","Ice/Settings/Models/AppSettings.swift","Ice/Settings/Models/GeneralSettings.swift","Ice/Settings/Models/HotkeysSettings.swift","Ice/Settings/SettingsManagers/AdvancedSettingsManager.swift","Ice/Settings/SettingsManagers/HotkeySettingsManager.swift","Ice/Settings/SettingsManagers/SettingsManager.swift","Ice/Settings/SettingsPanes/AboutSettingsPane.swift","Ice/Settings/SettingsPanes/AdvancedSettingsPane.swift","Ice/Settings/SettingsPanes/GeneralSettingsPane.swift","Ice/Settings/SettingsPanes/HotkeysSettingsPane.swift","Ice/Settings/SettingsPanes/MenuBarAppearanceSettingsPane.swift","Ice/Settings/SettingsPanes/MenuBarLayoutSettingsPane.swift","Ice/Settings/SettingsView.swift","Ice/Settings/SettingsWindow.swift","Ice/UI/HotkeyRecorder/HotkeyRecorder.swift","Ice/UI/HotkeyRecorder/HotkeyRecorderModel.swift","Ice/UI/IceBar/IceBarColorManager.swift","Ice/UI/IceUI/IceForm.swift","Ice/UI/IceUI/IceGradientPicker.swift","Ice/UI/IceUI/IceGroupBox.swift","Ice/UI/IceUI/IceLabeledContent.swift","Ice/UI/IceUI/IceMenu.swift","Ice/UI/IceUI/IcePicker.swift","Ice/UI/IceUI/IceSection.swift","Ice/UI/IceUI/IceSlider.swift","Ice/UI/IceUI/IceWindow.swift","Ice/UI/LayoutBar/LayoutBar.swift","Ice/UI/Modifiers/ErasedToAnyView.swift","Ice/UI/Modifiers/LocalEventMonitorModifier.swift","Ice/UI/Modifiers/OnFrameChange.swift","Ice/UI/Modifiers/OnKeyDown.swift","Ice/UI/Modifiers/OnWindowChange.swift","Ice/UI/Modifiers/Once.swift","Ice/UI/Pickers/CustomColorPicker/CustomColorPicker.swift","Ice/UI/Pickers/CustomGradientPicker/ColorStop.swift","Ice/UI/Pickers/CustomGradientPicker/CustomGradient.swift","Ice/UI/Pickers/CustomGradientPicker/CustomGradientPicker.swift","Ice/UI/Shapes/AnyInsettableShape.swift","Ice/UI/Utilities/IceColor.swift","Ice/UI/Utilities/IceGradient.swift","Ice/UI/ViewModifiers/BottomBar.swift","Ice/UI/ViewModifiers/LayoutBarStyle.swift","Ice/UI/ViewModifiers/LocalEventMonitorModifier.swift","Ice/UI/ViewModifiers/OnKeyDown.swift","Ice/UI/ViewModifiers/Once.swift","Ice/UI/ViewModifiers/ReadWindow.swift","Ice/UI/ViewModifiers/RemoveSidebarToggle.swift","Ice/UI/Views/AnnotationView.swift","Ice/UI/Views/BetaBadge.swift","Ice/UI/Views/CalloutBox.swift","Ice/UI/Views/HotkeyRecorder.swift","Ice/UI/Views/MenuBarItemContainer.swift","Ice/UI/Views/SectionedList.swift"],"learnings":[{"name":"2026-11-11-vice-bartender-icon-and-camera-gap-vinhnt.md","text":"---\ntitle: \"VIce Bartender: icon and camera gap on macOS 27.2 come from assessment mode\"\nauthor: Vinhnt\ndate: 2026-11-11\nbranch: macos-27\ncost: { minutes: 1, tokens: 1424 }\ntouches:\n  - Ice.xcodeproj/project.pbxproj\n  - Ice/Main/AppState.swift\n  - Ice/MenuBar/ControlItem/ControlItemImageSet.swift\n  - Ice/MenuBar/MacOS27/Concealer27.swift\n  - Ice/MenuBar/MacOS27/Core/ItemDrawing27.swift\n  - Ice/MenuBar/MacOS27/MenuBarItemProvider27.swift\n  - Ice/MenuBar/MacOS27/NativeAllowListConcealer27.swift\n  - Ice/Permissions/AppPermissions.swift\n  - Ice/Permissions/Permission.swift\n  - Ice/Permissions/PermissionsView.swift\n---\n\n## Decided\n- Root cause of the missing menu bar icon: on macOS 27.2 the app cannot read group.com.apple.controlcenter (cfprefsd logs 'requires user-preference-read or file-read-data sandbox access'; TCC kTCCServiceSystemPolicyAppDataDetailed 'would require user interaction'). NativeAllowListConcealer27.isAvailable is false, so Concealer27 falls back to assessment mode, where MenuBarAgent drops items of locally signed apps (VIce's own icon, VOpenKey AI) but their processes still report frames through AX.\n- The camera indicator gap: CaptureIndicator27 sits left of MenuBarItemProvider27.leftEdge, which counted the dropped apps' phantom frames. Fix: ItemDrawing27.isListed keeps only items the MenuBarAgent bar window lists (probe: AXWindows of com.apple.MenuBarAgent, children frames).\n- Added ControlCenterPermission (shown with status dots in the Permissions window and Advanced settings) and Concealer27.requestNativeAccess, which opens the plist directly so macOS can ask, retried on app activation.\n## Tried and ruled out\n- A direct open at launch while the screen is locked returns false at once and shows no prompt, so launch alone is not enough.\n## Watch out\n- Never verified that the prompt appears and that native mode brings the icon back: the screen was locked during the session. Check with: log show --predicate 'subsystem == \"vn.io.lssoft.vicebartender\" AND category == \"Concealer27\"' and the AX probe of VIce's own AXExtrasMenuBar (Ice.ControlItem.Visible must be on the built-in display).\n"}]}],"closed":{}}